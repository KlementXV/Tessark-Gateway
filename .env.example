# Mirror of the zod schema in src/lib/config.ts — keep both in sync, one line of comment
# per variable. Any of these can instead be provided as <NAME>_FILE=/path/to/file (Helm
# mounting the Secret as files rather than env vars); the file's content wins over the var.

# ---------------------------------------------------------------------------
# Secret — sensitive, required
# ---------------------------------------------------------------------------

# Prisma connection string (PostgreSQL). `connection_limit` matters once more than one
# replica is running — see docker-compose.dev.yml for a local instance.
DATABASE_URL="postgresql://tessark:tessark@localhost:5432/tessark_gateway?schema=public&connection_limit=5"

# NextAuth session/JWT signing secret, at least 32 characters. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Symmetric key used to encrypt registry/robot credentials at rest (AES-256-GCM via scrypt),
# at least 16 characters. NEVER rotate or lose this: doing so makes every stored credential
# permanently unreadable. Generate with:
#   openssl rand -base64 32
GATEWAY_SECRET_KEY=""

# Bootstrap credentials for the first SUPERADMIN account. Only read once, by
# `prisma/seed.ts` — not required by the web server itself, and not read again afterwards
# (manage further accounts from /settings/users).
GATEWAY_ADMIN_USERNAME="admin"
GATEWAY_ADMIN_PASSWORD="change-me"

# Extra users created once at first boot, alongside the superadmin above (also read only
# by prisma/seed.ts, only when the User table is still empty). JSON array of
# { username, email, password, name?, role? } — role defaults to USER. Manage further
# accounts from /settings/users after that.
# GATEWAY_SEED_USERS="[]"

# Upstream sources (mirror targets) created once at first boot, same gating as above. JSON
# array shaped like the add-source form: { name, host, authType?, username?, secret?,
# allowedRepos, enabled?, description? }. See src/lib/sources/presets.ts for ready-made
# examples (Docker Hub, GHCR, Quay, ...).
# GATEWAY_SEED_SOURCES="[]"

# ---------------------------------------------------------------------------
# ConfigMap — non-sensitive, every value has a safe default
# ---------------------------------------------------------------------------

# Public URL of this instance, behind the Ingress (drives NextAuth redirects). Required in
# production behind a reverse proxy.
# AUTH_URL="https://gateway.example.com"

# Trust the X-Forwarded-* headers from the reverse proxy in front of NextAuth. Default: true.
# AUTH_TRUST_HOST="true"

# Enables the pull-request feature (mirroring images via Kubernetes Jobs). Set to false to
# run outside a cluster without the feature crashing on first use. Default: true.
# K8S_ENABLED="true"

# Namespace the Gateway creates Jobs/Secrets in. Defaults to the pod's own namespace (read
# from the ServiceAccount mount) — only set this if pulls should target a different one.
# K8S_NAMESPACE=""

# Timeout for calls to the Kubernetes API server, in milliseconds. Default: 10000.
# K8S_HTTP_TIMEOUT_MS="10000"

# Image used by the skopeo Job that mirrors an upstream image into a Harbor project.
SKOPEO_IMAGE="quay.io/skopeo/stable:latest"

# How long a finished skopeo Job (and its Pod) is kept around before Kubernetes garbage
# collects it, in seconds. Default: 3600.
# SKOPEO_JOB_TTL_SECONDS="3600"

# Number of retries for a failed skopeo Job. Default: 1.
# SKOPEO_JOB_BACKOFF_LIMIT="1"

# Kills a skopeo Job that's still running after this many seconds — stops a stuck mirror
# from running forever. Default: 1800.
# SKOPEO_JOB_ACTIVE_DEADLINE_SECONDS="1800"

# CPU/memory request and limit for the skopeo Job's container.
# SKOPEO_CPU_REQUEST="100m"
# SKOPEO_CPU_LIMIT="1"
# SKOPEO_MEMORY_REQUEST="128Mi"
# SKOPEO_MEMORY_LIMIT="512Mi"

# Placement for the skopeo Job's Pod — JSON object / JSON array.
# SKOPEO_NODE_SELECTOR="{}"
# SKOPEO_TOLERATIONS="[]"

# Comma-separated list of imagePullSecrets, only needed if SKOPEO_IMAGE lives in a private
# registry.
# SKOPEO_IMAGE_PULL_SECRETS=""

# ServiceAccount the skopeo Job's Pod runs as, if it needs one dedicated to it.
# SKOPEO_SERVICE_ACCOUNT=""

# Fallback push account for the mirror jobs. When a destination project has no robot account
# of its own, Gateway provisions a Harbor system-level robot by this name on the target Harbor
# (push/pull on every project) and the skopeo Job uses it. Set the flag to false to require a
# per-project robot instead. The Harbor admin password is never given to a Job.
# SYSTEM_ROBOT_ENABLED="true"
# SYSTEM_ROBOT_NAME="tessark-gateway"

# Timeout for outgoing calls to Harbor, in milliseconds. Default: 15000.
# HARBOR_HTTP_TIMEOUT_MS="15000"

# Timeout for testing a registry/source connection, in milliseconds. Default: 8000.
# REGISTRY_CHECK_TIMEOUT_MS="8000"

# Branding shown before anyone has visited /settings on a fresh install (white-label
# pre-branding).
DEFAULT_BRAND_NAME="Tessark"
DEFAULT_BRAND_TAGLINE="Gateway"
# DEFAULT_PRIMARY_COLOR="#3366ff"
# DEFAULT_LOGO_URL=""

# Upload size limits, in bytes.
# LOGO_MAX_BYTES="524288"
# AVATAR_MAX_BYTES="262144"

# UI language ("en" or "fr") served to a visitor who has not picked one yet and whose browser
# does not advertise a supported Accept-Language. Default: en.
# DEFAULT_LOCALE="en"

# Log verbosity: debug | info | warn | error. Default: info.
# LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Single sign-on (OIDC) — off by default
# ---------------------------------------------------------------------------
# Delegates authentication to an OpenID Connect provider. Keycloak is the reference target
# (and can itself broker LDAP/AD/SAML/Google), but any compliant provider works: everything
# beyond the issuer is read from <issuer>/.well-known/openid-configuration.
#
# The redirect URI to declare on the provider side is:  <AUTH_URL>/api/auth/callback/oidc
#
# OIDC_ENABLED="false"
# OIDC_ISSUER="https://keycloak.example.com/realms/tessark"
# OIDC_CLIENT_ID="tessark-gateway"
# OIDC_CLIENT_SECRET="..."          # sensitive — Secret, not ConfigMap (OIDC_CLIENT_SECRET_FILE works too)
# OIDC_SCOPES="openid profile email"
# OIDC_DISPLAY_NAME="Single sign-on"

# Keep the local username/password form available alongside SSO. Leave this at true: it is
# the way back in when the identity provider is unreachable. Default: true.
# OIDC_ALLOW_LOCAL_LOGIN="true"

# false = only users already in the database (matched on their stored subject) may sign in;
# an unknown subject is refused rather than provisioned on the fly. Default: true.
# OIDC_ALLOW_SIGNUP="true"

# Whether a first-time subject may adopt a pre-existing *local* account with the same email.
# Off by default: emails are mutable and not always verified, so matching on one turns a
# compromised mailbox into account takeover. `email_verified` is required even when on.
# Intended to be switched on for a migration, then off again. Default: false.
# OIDC_LINK_BY_EMAIL="false"

# Role mapping. OIDC_ROLE_CLAIM is a dotted path into the token claims ("groups" for a
# Keycloak group mapper, "realm_access.roles" for realm roles). OIDC_ROLE_MAPPING maps claim
# values to SUPERADMIN | ADMIN | USER; the highest match wins, and anything unmapped falls
# back to OIDC_DEFAULT_ROLE. Re-applied at every sign-in: the provider owns the role.
# OIDC_ROLE_CLAIM="groups"
# OIDC_ROLE_MAPPING='{"gateway-admins":"ADMIN","gateway-owners":"SUPERADMIN"}'
# OIDC_DEFAULT_ROLE="USER"

# "local" clears the Gateway session only (the provider session survives, so signing in again
# needs no prompt); "idp" also redirects to the provider's end_session_endpoint, signing the
# user out of every application in the realm. Default: local.
# OIDC_LOGOUT_MODE="local"

# How stale a session's cached role/disabled flag may get before it is re-read from the
# database. Applies to local sessions too — without it, a demoted or disabled user keeps
# their access until the JWT expires. 0 = re-read on every request. Default: 300.
# AUTH_SESSION_REFRESH_SECONDS="300"

# Enables Bearer-token authentication (API tokens created from Settings) on every /api/*
# route, in addition to the session cookie. Off by default — a fresh install exposes
# nothing beyond the web UI until this is explicitly turned on. Default: false.
# API_EXTERNAL_ENABLED="false"

# Upper bound, in days, offered when creating an API token from Settings. Default: 365.
# API_TOKEN_MAX_TTL_DAYS="365"

# Request budget per token (or per IP, before a token resolves), per minute. Not applied to
# session-cookie requests from the web UI. Default: 60.
# API_RATE_LIMIT_PER_MINUTE="60"

# Enables POST /api/mcp (a Streamable HTTP MCP server for LLM clients), authenticated by
# Bearer API token only — never the session cookie. Off by default. Default: false.
# MCP_ENABLED="false"

# Enables the MCP server's write tools (create_pull_request, approve_pull_request,
# create_project) on top of MCP_ENABLED — without it, an LLM client only gets read-only
# tools. Default: false.
# MCP_WRITE_TOOLS_ENABLED="false"

# --- custom CA (beta) ---

# Lets an admin attach a private certificate authority to a registry or an upstream source,
# so a Harbor or an upstream behind a company CA can be reached over verified HTTPS
# (docs/plan-custom-ca-beta.md). Off by default. Turning it off again keeps the CAs already
# stored but refuses any new transfer or mirror that needs one — suspend the installed
# CronJobs first, they tick without asking the Gateway. Default: false.
# CUSTOM_CA_BETA_ENABLED="false"

# --- notifications ---

# Outgoing webhook for the same events the in-app bell records (project/pull/quota requests
# and their decisions). Empty disables it — there is no separate on/off flag. Treated as a
# credential and mounted from the Secret, not the ConfigMap: a Slack incoming-webhook URL is
# unguessable by design and anyone holding it can post to the channel.
# NOTIFICATIONS_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Body shape: json | slack | teams. "slack" posts { text } (also fits Mattermost and
# Discord-compatible endpoints), "teams" a MessageCard, "json" the event verbatim.
# Default: json.
# NOTIFICATIONS_WEBHOOK_FORMAT="json"

# Bounds how long an unreachable webhook endpoint can delay the request that triggered it —
# the POST is awaited inside the handler. Default: 5000.
# NOTIFICATIONS_WEBHOOK_TIMEOUT_MS="5000"

# Read notifications older than this are swept when their owner marks the list read. Unread
# ones are never deleted. Default: 30.
# NOTIFICATION_RETENTION_DAYS="30"

# Persistent cluster recovery; 0 disables periodic catch-up, not initial/recovery copies.
REPLICATION_WORKER_ENABLED=true
REPLICATION_POLL_SECONDS=60
REPLICATION_VERIFY_SECONDS=300
REPLICATION_CATCHUP_SECONDS=3600

# Scheduled builds beta: build and publish deploy/build-runner, then pin its digest.
BUILDS_BETA_ENABLED=false
BUILDS_RUNNER_IMAGE=
BUILDS_NAMESPACE=
BUILDS_SERVICE_ACCOUNT=tessark-build-runner
BUILDS_POLL_SECONDS=15
BUILDS_DEADLINE_SECONDS=1800
BUILDS_JOB_TTL_SECONDS=604800
BUILDS_RETENTION_DAYS=90
BUILDS_CPU_REQUEST=500m
BUILDS_CPU_LIMIT=2
BUILDS_MEMORY_REQUEST=512Mi
BUILDS_MEMORY_LIMIT=2Gi
BUILDS_STORAGE_LIMIT=10Gi
BUILDS_NODE_SELECTOR={}
BUILDS_TOLERATIONS=[]
BUILDS_IMAGE_PULL_SECRETS=[]
